@baseUrl = http://localhost:3000

### 1. Create a task
POST {{baseUrl}}/tasks
Content-Type: application/json

{
  "title": "Buy groceries"
}

### 2. Create another task
POST {{baseUrl}}/tasks
Content-Type: application/json

{
  "title": "Walk the dog",
  "description": "evening walk"
}

### 3. List all tasks
GET {{baseUrl}}/tasks

### 4. Get one task
GET {{baseUrl}}/tasks/1

### 5. Get a task that doesn't exist (expect 404)
GET {{baseUrl}}/tasks/999

### 6. Update a task
PUT {{baseUrl}}/tasks/1
Content-Type: application/json

{
  "title": "Buy groceries and milk"
}

### 7. Invalid body (expect 400 validation error)
POST {{baseUrl}}/tasks
Content-Type: application/json

{}

### 8. Delete a task
DELETE {{baseUrl}}/tasks/2
