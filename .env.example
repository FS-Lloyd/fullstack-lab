# Consolidated reference for every environment variable used across docker-compose.yml,
# docker-compose.dev.yml, docker-compose.prod.yml, and apps/api. Per-app .env.example files
# (apps/api/.env.example) remain for app-local `npm run` workflows outside Docker.

# ── Postgres (used by the `db` service, and to build POSTGRES_URL below) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tasks
# Only needed when connecting to Postgres directly from the host (e.g. running
# `npm run start:dev` outside Docker). Inside the compose files, the api service always
# connects via the `db` hostname/port instead of these.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── API (apps/api) ──
# Selects which apps/api/.env.<NODE_ENV> file is loaded alongside apps/api/.env.shared
# (see apps/api/src/app.module.ts ConfigModule.forRoot envFilePath).
NODE_ENV=development
# Full Postgres connection string used by TypeORM (apps/api/src/database/database.config.ts,
# data-source.ts). The compose files set this directly for the api service; only needed here
# for running the API outside Docker.
POSTGRES_URL=postgresql://postgres:changeme@localhost:5432/tasks
# HTTP port the Nest app listens on. NOTE: apps/api/src/config/configuration.ts defaults this
# to 4201 in code, but the Dockerfile and every compose file set PORT=3000 — 3000 is the value
# that actually takes effect in containers; the 4201 code default is a known dead value.
PORT=3000
# Max items returned/allowed per task list (apps/api/src/config/task-configuration.ts).
MAX_TASK_ITEMS=10
# Date format string, defined in apps/api/.env.shared.
DATE_FORMAT=MMMM D, YYYY

# ── Web (apps/web) ──
# apps/web reads no environment variables at runtime; it talks to the API via nginx's
# /api/ reverse proxy in production and Vite's dev-server /api proxy in development.
# VITE_PROXY_TARGET below is only used by docker-compose.dev.yml, to redirect the
# containerized Vite dev server's proxy target from localhost to the `api` service name.
VITE_PROXY_TARGET=http://localhost:3000
